{
  "name": "float-monorepo",
  "version": "0.1.0",
  "private": true,
  "description": "Float \u2014 an undercollateralised USDC credit line for autonomous agents, gated by World ID, recorded on Arc, settled on Arc and Hedera",
  "workspaces": [
    "web",
    "agent-demo"
  ],
  "scripts": {
    "dev": "npm --workspace=web run dev",
    "dev:agent": "npm --workspace=agent-demo run dev",
    "dev:mock": "npm --workspace=agent-demo run mock",
    "premium": "npm --prefix float-premium-api start",
    "lint": "npm --workspace=web run lint",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p web/tsconfig.json && tsc --noEmit -p agent-demo/tsconfig.json",
    "deposit": "tsx --env-file=.env scripts/deposit-gateway.ts",
    "balances": "tsx --env-file=.env scripts/check-all-balances.ts",
    "float:fetch": "tsx --env-file=.env hedera/agent/cli.ts",
    "float:mcp": "tsx --env-file=.env hedera/mcp/server.ts",
    "hedera:announce": "tsx --env-file=.env hedera/scripts/announce.ts",
    "hedera:balance": "tsx --env-file=.env hedera/scripts/set-agent-balance.ts",
    "hedera:demo": "tsx --env-file=.env hedera/scripts/demo.ts",
    "hedera:issue-token": "tsx --env-file=.env hedera/scripts/issue-token.ts",
    "hedera:new-agent": "tsx --env-file=.env hedera/scripts/new-agent.ts",
    "hedera:payer": "tsx --env-file=.env hedera/service/payer-api.ts",
    "hedera:probe-default": "tsx --env-file=.env hedera/scripts/probe-default.ts",
    "hedera:reconcile": "tsx --env-file=.env hedera/scripts/reconcile.ts",
    "hedera:service": "tsx --env-file=.env hedera/service/server.ts",
    "hedera:setup": "tsx --env-file=.env hedera/scripts/setup.ts",
    "hedera:watch": "tsx --env-file=.env hedera/scripts/watch-schedule.ts",
    "hedera:lifecycle": "tsx --env-file=.env hedera/scripts/lifecycle.ts"
  },
  "keywords": [
    "ai-agents",
    "defi",
    "usdc",
    "arc",
    "world-id",
    "selfie-check",
    "x402",
    "nanopayments",
    "hedera"
  ],
  "author": "Float Team",
  "license": "MIT",
  "dependencies": {
    "@circle-fin/x402-batching": "^3.4.0",
    "@hiero-ledger/sdk": "2.85.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@types/express": "^5.0.6",
    "@worldcoin/agentkit": "^0.2.1",
    "@x402/core": "^2.25.0",
    "@x402/evm": "^2.25.0",
    "@x402/express": "^2.25.0",
    "@x402/fetch": "^2.25.0",
    "@x402/hedera": "^2.25.0",
    "bs58": "^4.0.1",
    "express": "^5.2.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/bs58": "^4.0.4",
    "tsx": "^4.23.13"
  }
}
