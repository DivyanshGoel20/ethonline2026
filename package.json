{
  "name": "float-monorepo",
  "version": "0.1.0",
  "private": true,
  "description": "Float — Controlled USDC credit lines for AI agents with World Selfie Check, Arc settlement, and The Graph indexing",
  "workspaces": [
    "web",
    "subgraph",
    "agent-demo"
  ],
  "scripts": {
    "dev": "npm --workspace=web run dev",
    "dev:agent": "npm --workspace=agent-demo run dev",
    "dev:mock": "npm --workspace=agent-demo run mock",
    "lint": "npm --workspace=web run lint",
    "deposit": "tsx --env-file=.env scripts/deposit-gateway.ts",
    "hedera:setup": "tsx --env-file=.env hedera/scripts/setup.ts",
    "hedera:service": "tsx --env-file=.env hedera/service/server.ts",
    "hedera:demo": "tsx --env-file=.env hedera/scripts/demo.ts",
    "hedera:balance": "tsx --env-file=.env hedera/scripts/set-agent-balance.ts",
    "hedera:watch": "tsx --env-file=.env hedera/scripts/watch-schedule.ts",
    "hedera:payer": "tsx --env-file=.env hedera/service/payer-api.ts"
  },
  "keywords": [
    "ai-agents",
    "defi",
    "usdc",
    "arc",
    "world-id",
    "selfie-check",
    "the-graph",
    "x402",
    "nanopayments"
  ],
  "author": "Float Team",
  "license": "MIT",
  "dependencies": {
    "@circle-fin/x402-batching": "^3.4.0",
    "@types/express": "^5.0.6",
    "@worldcoin/agentkit": "^0.2.1",
    "@x402/core": "^2.25.0",
    "@x402/evm": "^2.25.0",
    "@x402/express": "^2.25.0",
    "@x402/fetch": "^2.25.0",
    "@x402/hedera": "^2.25.0",
    "express": "^5.2.1"
  },
  "devDependencies": {
    "tsx": "^4.23.13"
  }
}
