# Float's Hedera rail.
#
# 1. Create a testnet account at https://portal.hedera.com (ECDSA key).
# 2. Claim testnet USDC at https://faucet.circle.com -> Hedera Testnet.
# 3. Fill in the two operator values below and run: npm run hedera:setup
#    That prints the rest of these lines for you to paste back.

HEDERA_OPERATOR_ID=0.0.xxxxxxx
HEDERA_OPERATOR_KEY=0x...

# Written by scripts/setup.ts
HEDERA_AGENT_ID=
HEDERA_AGENT_KEY=
HEDERA_SELLER_ID=
HEDERA_SELLER_KEY=
HEDERA_BORROWER_ID=
HEDERA_BORROWER_KEY=
FLOAT_HCS_TOPIC_ID=

# Blocky402 hosted testnet facilitator. No API key required.
BLOCKY402_URL=https://api.testnet.blocky402.com
