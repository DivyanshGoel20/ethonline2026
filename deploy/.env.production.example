# Float — production environment, per service.
#
# Set these in your host's variable UI, not in a file. Nothing here is read from
# disk in production: every start command uses --env-file-if-exists, so a missing
# .env is fine and the platform's injected variables are what count.
#
# ── SHARED BY MORE THAN ONE SERVICE ──────────────────────────────────────────
# These two MUST be byte-identical across web and payer. Mandates are signed by
# web and the payer is guarded by the second; a mismatch fails closed, quietly,
# and looks like "the agent can't spend" rather than "the secret is wrong".
FLOAT_SESSION_SECRET=          # 32+ chars, generate once: openssl rand -base64 32
FLOAT_PAYER_SECRET=            # 32+ chars, generate once

# ── SERVICE: feed  (public — the bounty requires this reachable) ─────────────
# No state, no volume. Sells the metered risk data.
#   start: npx tsx hedera/service/server.ts
HEDERA_OPERATOR_ID=            # 0.0.x
HEDERA_OPERATOR_KEY=           # ECDSA, raw hex
HEDERA_SELLER_ID=
HEDERA_SELLER_KEY=
BLOCKY402_URL=https://api.testnet.blocky402.com
# PORT is injected by the host. Do NOT set HEDERA_SERVICE_PORT here — it wins
# over PORT and the proxy would reach nothing.

# ── SERVICE: payer  (not public; guarded by FLOAT_PAYER_SECRET) ──────────────
# Holds keys and writes state. Needs a volume mounted at hedera/data.
#   start: npx tsx hedera/service/payer-api.ts
#   volume: hedera/data
# Same HEDERA_OPERATOR_* as above, plus:
FLOAT_HCS_TOPIC_ID=
HEDERA_SERVICE_URL=            # the feed's public URL
FLOAT_TERM_SECONDS=604800      # 7 days
# FLOAT_TRANCHE_BATCHING=true  # optional; off by default

# ── SERVICE: web  (public) ───────────────────────────────────────────────────
# Writes state. Needs a volume mounted at web/data.
#   build: npm ci && npm --workspace=web run build
#   start: npm --workspace=web run start
#   volume: web/data
HEDERA_PAYER_URL=              # the payer's internal URL — no trailing slash
NEXT_PUBLIC_WORLD_APP_ID=
NEXT_PUBLIC_WORLD_ACTION=float-human-verify
NEXT_PUBLIC_WORLD_RP_ID=
WORLD_API_KEY=
PRIVATE_KEY=                   # Arc facility owner
FLOAT_FUNDING_PRIVATE_KEY=     # Circle Gateway funding wallet
ARC_RPC_URL=https://rpc.testnet.arc.network
FLOAT_CREDIT_FACILITY_ADDRESS=0x43bC32b6D54be323b9072494Efb8E8e073E642C4
NEXT_PUBLIC_FLOAT_CREDIT_FACILITY_ADDRESS=0x43bC32b6D54be323b9072494Efb8E8e073E642C4
NEXT_PUBLIC_USDC_ADDRESS=

# ── SERVICE: premium  (public) ───────────────────────────────────────────────
# Arc x402 resources. No state.
#   build: npm ci && npm ci --prefix float-premium-api
#   start: npm --prefix float-premium-api start
SELLER_WALLET_ADDRESS=
FACILITATOR_URL=https://gateway-api-testnet.circle.com

# ── AGENTS RUNNING OUTSIDE THE CLUSTER (laptop, MCP, CI) ─────────────────────
# Not a service. Point a local agent at the deployed app.
FLOAT_APP_URL=                 # the web service's public URL
FLOAT_AGENT_TOKEN=             # issued by a verified human at POST /api/agent-token
